{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["baseline-terraform", "baseline-aws-knowledge"],
  "permissions": {
    "deny": ["Agent", "WebSearch", "WebFetch"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/verify_baselines_hook.py\"",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
