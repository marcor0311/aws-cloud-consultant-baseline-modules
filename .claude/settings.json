{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "low",
  "enabledMcpjsonServers": [
    "baseline-terraform",
    "baseline-aws-knowledge",
    "baseline-aws-pricing"
  ],
  "permissions": {
    "deny": [
      "Agent",
      "WebSearch",
      "WebFetch",
      "mcp__baseline-aws-knowledge__aws___run_script",
      "mcp__baseline-aws-knowledge__aws___get_presigned_url",
      "mcp__baseline-aws-knowledge__aws___get_tasks"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/verify_baselines_hook.py\"",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
